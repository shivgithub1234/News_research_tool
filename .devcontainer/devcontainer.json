{
  "name": "News Research Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}},
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": {"demo": "python -m streamlit run main.py --server.headless true --server.address 0.0.0.0"},
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "Public demo", "onAutoForward": "openPreview"}}
}
