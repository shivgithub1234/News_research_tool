# Required for answer generation through Groq.
GROQ_API_KEY=
# No Hugging Face token is required for the public local embedding model.

# Hosted mode uses each visitor's own free-tier key and collection directory.
NEWS_RESEARCH_MODE=hosted
# For your own workspace: set mode to private and choose a strong password (12+ characters).
APP_PASSWORD=
# Only set true after checking the key's account is on the free tier.
# This flag cannot query or change the provider's billing plan.
GROQ_FREE_TIER_CONFIRMED=false
# Optional: an absolute path to durable local storage for private collections.
# NEWS_RESEARCH_DATA_DIR=
